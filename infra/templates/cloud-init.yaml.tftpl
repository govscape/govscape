#cloud-config
# Runs the GovScape API container under systemd. On every start the container
# pulls the serving indices from source.coop (scripts.serving.run_gunicorn)
# into /data, then starts gunicorn on port ${api_port}. /data is the instance's
# local NVMe instance store, which comes up blank after every stop/start, so it
# is formatted on boot when needed; the indices are downloaded again anyway.
package_update: true
packages:
  - docker

write_files:
  - path: /usr/local/sbin/mount-instance-store
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail
      dev=$(lsblk -dnpo NAME,MODEL | awk '/Instance Storage/ {print $1; exit}')
      if [ -z "$dev" ]; then
        echo "no NVMe instance store found" >&2
        exit 1
      fi
      blkid "$dev" >/dev/null || mkfs.xfs -f "$dev"
      mkdir -p /data
      mountpoint -q /data || mount -o noatime "$dev" /data

  - path: /etc/systemd/system/govscape-data.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Mount the NVMe instance store at /data

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/usr/local/sbin/mount-instance-store

  - path: /etc/systemd/system/govscape-api.service
    permissions: "0644"
    content: |
      [Unit]
      Description=GovScape API
      Requires=docker.service govscape-data.service
      After=docker.service govscape-data.service network-online.target
      Wants=network-online.target

      [Service]
      Restart=always
      RestartSec=10
      # Pulling the image and downloading indices can take a while.
      TimeoutStartSec=0
      ExecStartPre=-/usr/bin/docker rm -f govscape-api
      ExecStartPre=/usr/bin/docker pull ${app_image}
      ExecStart=/usr/bin/docker run --rm --name govscape-api \
        -p ${api_port}:${api_port} \
        -v /data:/data \
        -e GUNICORN_BIND=0.0.0.0:${api_port} \
        -e GUNICORN_WORKERS=${gunicorn_workers} \
        -e GUNICORN_THREADS=4 \
        -e HF_HOME=/data/hf-cache \
        -e AWS_REGION=us-west-2 \
        -e AWS_EC2_METADATA_DISABLED=true \
        ${app_image} \
        poetry run python -m scripts.serving.run_gunicorn \
        --backend s3 --remote_data_directory ${serving_data_dir} \
        --local_data_directory /data/${serving_data_dir} \
        ${server_args}
      ExecStop=/usr/bin/docker stop -t 120 govscape-api

      [Install]
      WantedBy=multi-user.target

runcmd:
  - systemctl enable --now docker
  - systemctl daemon-reload
  - systemctl enable --now govscape-api.service
